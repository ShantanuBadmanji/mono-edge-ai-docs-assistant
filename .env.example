# LLM — free tier from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Shared secret for HMAC-SHA256 webhook verification
WEBHOOK_SECRET=change-me-to-a-random-string

# SQLite database path (created automatically on first run)
DATABASE_URL=sqlite+aiosqlite:///./data/data.db

# ChromaDB persistence directory
CHROMA_PATH=./data/chroma

# Groq model to use (llama-3.3-70b-versatile is recommended, free tier)
GROQ_MODEL=llama-3.3-70b-versatile
